# BitBrowser API endpoint (running on same machine or LAN)
BITBROWSER_URL=http://127.0.0.1:54345

# 2Captcha API key for solving captchas automatically (leave empty to solve manually)
TWOCAPTCHA_API_KEY=

# Proxy settings
PROXY_USERNAME_PREFIX=
PROXY_PASSWORD=
PROXY_HOST=niceproxy.io
PROXY_PORT=17521
PROXY_SESSION_TTL=30

# Max number of accounts processed concurrently
MAX_TASK_CONCURRENCY=3

# Delete BitBrowser profile after account created successfully
DELETE_BROWSER_AFTER_COMPLETE=true

# ipdata.co API key for proxy geo lookup (optional)
IPDATA_API_KEY=
